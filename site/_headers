# Cloudflare Pages _headers — caching, compression, security
# - "! Access-Control-Allow-Origin" drops the "*" CORS header Pages adds by
#   default: nothing on this site needs to be read cross-origin.
# - CSP is Report-Only first: it logs violations in the browser console
#   without blocking anything. Switch to Content-Security-Policy once clean.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  ! Access-Control-Allow-Origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://eagle-ridge-trucks.fblister.workers.dev https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Static assets — short cache so deploys propagate fast (5 min).
# Bump the ?v= version on js/css references when you change them to
# force browsers to refetch immediately (cache-busting).
/css/*
  Cache-Control: public, max-age=300

/js/*
  Cache-Control: public, max-age=300

/images/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

# Inventory snapshot is rebuilt hourly; main.js revalidates it on each load
/data/inventory.json
  Cache-Control: public, max-age=300

# HTML pages: always revalidated so content stays fresh, but cacheable
# (max-age=0 + must-revalidate instead of no-store keeps back/forward-cache
# and conditional requests working, which no-store disabled).
/
  Cache-Control: public, max-age=0, must-revalidate

/inventory
  Cache-Control: public, max-age=0, must-revalidate

/inventory/*
  Cache-Control: public, max-age=0, must-revalidate

/v/*
  Cache-Control: public, max-age=0, must-revalidate

/vehicle
  Cache-Control: public, max-age=0, must-revalidate

/about
  Cache-Control: public, max-age=0, must-revalidate

/forum
  Cache-Control: public, max-age=0, must-revalidate

/forum/*
  Cache-Control: public, max-age=0, must-revalidate

/locations/*
  Cache-Control: public, max-age=0, must-revalidate

/blog
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# NOTE: do NOT set Content-Encoding manually. Cloudflare encodes responses
# (brotli/gzip) automatically per Accept-Encoding; a manual header can
# contradict the actual body and browsers then fail to decode the CSS/JS
# and render pages unstyled (seen on mobile).
