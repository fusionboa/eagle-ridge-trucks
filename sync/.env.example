# Eagle Ridge Trucks — sync env (copy to .env and fill in)
# NEVER commit the real .env file (it's gitignored).

# FTP feed (Eagle Ridge GM — public feed, only car data)
FTP_HOST=ftp.edealer.ca
FTP_USER=FBEagleRidgeGM
FTP_PASS=CHANGE_ME
FTP_PATH=/
CSV_FILE=feed.csv

# Cloudflare Worker (where trucks get pushed)
WORKER_URL=https://eagle-ridge-trucks.YOUR_SUBDOMAIN.workers.dev

# Bridge token — must match the worker's BRIDGE_TOKEN secret
BRIDGE_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# Optional: local storage only, no push if unset
# SYNC_INTERVAL=3600000
